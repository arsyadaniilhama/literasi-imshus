# ============================================================
# Blog Santri IMSHUS Isy Karima — Environment Template
# Salin file ini menjadi `.env.local` dan isi nilainya.
# JANGAN masukkan nilai asli ke file ini — `.env.example` masuk ke git.
# ============================================================

# --- Supabase (Settings → API) ---
NEXT_PUBLIC_SUPABASE_URL="https://YOUR-PROJECT-REF.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# --- PostgreSQL (Project Settings → Database → Connection string) ---
DATABASE_URL="postgresql://postgres:PASSWORD@db.YOUR-PROJECT-REF.supabase.co:5432/postgres"

# --- App ---
NEXT_PUBLIC_APP_URL="http://localhost:3000"
